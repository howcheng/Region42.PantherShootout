# Exclude build, binary, and test output directories
**/bin/
**/obj/
**/out/
**/TestResults/

# Exclude IDE, AI assistant, and Git directories
.vs/
.vscode/
.cursor/
.git/
.github/
.idea/
*.user
*.suo
*.sln.docstates

# Exclude local JSON storage data, logs, and temp files
.local-data/
*.log
*.tmp
temp/

# Exclude test projects, sample workbooks, and repository documentation not needed at runtime
test/
docs/
README.md
LICENSE
*.xlsx

# Exclude local environment/app settings overrides
**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings*.user.json

# Docker and deployment files
Dockerfile
.dockerignore
docker-compose*
