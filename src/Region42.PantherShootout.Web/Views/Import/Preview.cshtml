@model Region42.PantherShootout.Web.Models.SchedulePreviewViewModel
@using Region42.PantherShootout.Web.Controllers
@using Region42.PantherShootout.Web.Helpers
@{
	ViewData["Title"] = "Preview Schedule Import";
}

@section Styles {
	<link rel="stylesheet" href="~/css/schedule-import.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
	<div>
		<h1 class="h3 mb-1">Preview Schedule Import</h1>
		<div class="text-muted small">
			<strong>Target Year:</strong> @Model.TournamentName (@Model.Year) &bull;
			<strong>Workbook:</strong> @Model.FileName
		</div>
	</div>
	<a asp-action="Upload" asp-route-yearId="@Model.TournamentYearId" class="btn btn-outline-secondary btn-sm">
		<i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Upload Different File
	</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
	<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
}

<div class="import-summary-grid mb-4">
	<div class="import-stat-card">
		<div class="import-stat-value">@Model.Preview.Divisions.Count</div>
		<div class="import-stat-label">Divisions</div>
	</div>
	<div class="import-stat-card">
		<div class="import-stat-value">@Model.TotalPools</div>
		<div class="import-stat-label">Pools</div>
	</div>
	<div class="import-stat-card">
		<div class="import-stat-value">@Model.TotalTeams</div>
		<div class="import-stat-label">Teams</div>
	</div>
	<div class="import-stat-card">
		<div class="import-stat-value">@Model.TotalPoolPlayGames</div>
		<div class="import-stat-label">Pool Games</div>
	</div>
	<div class="import-stat-card">
		<div class="import-stat-value">@Model.TotalChampionshipGames</div>
		<div class="import-stat-label">Bracket Games</div>
	</div>
	<div class="import-stat-card">
		<div class="import-stat-value">@Model.TotalShootoutMatchups</div>
		<div class="import-stat-label">PSO Matchups</div>
	</div>
</div>

@if (!Model.Preview.IsValid)
{
	<div class="alert alert-danger mb-4" role="alert">
		<h2 class="h6 fw-bold mb-2">
			<i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
			@Model.Preview.Errors.Count Validation @(Model.Preview.Errors.Count == 1 ? "Issue Needs" : "Issues Need") Attention Before Import
		</h2>
		<ul class="small mb-0 ps-3">
			@foreach (var err in Model.Preview.Errors)
			{
				<li>
					<strong>[@err.SheetName @(string.IsNullOrWhiteSpace(err.CellReference) ? "" : err.CellReference)]</strong>
					@err.Message
				</li>
			}
		</ul>
	</div>
}

@if (Model.Preview.BracketCellMappings.Count > 0)
{
	<div class="card mb-4">
		<div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
			<div>
				<h2 class="h6 mb-0 fw-bold">Championship &amp; Consolation Cell Mappings (@Model.Preview.BracketCellMappings.Count)</h2>
				<small class="text-muted">Verify or override how non-pool-play cells on the Schedule tab map to division bracket slots.</small>
			</div>
			<span class="badge @(Model.Preview.BracketCellMappings.All(c => c.IsIgnored || (c.ResolvedDivisionKey != null && c.ResolvedSlot != null)) ? "bg-success" : "bg-danger")">
				@Model.Preview.BracketCellMappings.Count(c => c.IsIgnored || (c.ResolvedDivisionKey != null && c.ResolvedSlot != null)) / @Model.Preview.BracketCellMappings.Count Resolved
			</span>
		</div>
		<div class="card-body">
			<form method="post" asp-action="Revalidate" id="revalidateOverridesForm">
				<input type="hidden" name="previewToken" value="@Model.PreviewToken" />

				@for (var i = 0; i < Model.Preview.BracketCellMappings.Count; i++)
				{
					var cell = Model.Preview.BracketCellMappings[i];
					var overrideInput = Model.Overrides[i];
					var isResolved = cell.IsIgnored || (cell.ResolvedDivisionKey is not null && cell.ResolvedSlot is not null);
					var swatchUri = ColorSwatchHelper.ToSvgDataUri(cell.FillRgb);

					<div class="bracket-override-card @(isResolved ? (cell.IsIgnored ? "ignored" : "") : "unresolved")"
						 data-override-index="@i"
						 data-cell-reference="@cell.CellReference">
						<input type="hidden" name="overrides[@i].CellReference" value="@cell.CellReference" />
						<div class="row g-2 align-items-center">
							<div class="col-12 col-md-5">
								<div class="d-flex align-items-center gap-2 mb-1">
									<span class="badge bg-secondary">@cell.CellReference</span>
									@if (swatchUri is not null)
									{
										<img src="@swatchUri" alt="Cell fill #@cell.FillRgb" title="Fill #@cell.FillRgb" class="color-swatch-img" />
									}
									<strong class="text-break">@cell.RawText</strong>
								</div>
								<div class="small text-muted">
									@cell.ScheduledDateTime.ToString("ddd, MMM d h:mm tt") &bull; @cell.Location
								</div>
							</div>
							<div class="col-12 col-md-3">
								@if (cell.IsIgnored)
								{
									<span class="badge bg-secondary">Ignored</span>
								}
								else if (cell.ResolvedDivisionName is not null && cell.ResolvedSlot is not null)
								{
									<span class="badge @(cell.IsAutoResolved ? "bg-success-subtle text-success-emphasis" : "bg-info-subtle text-info-emphasis")">
										@cell.ResolvedDivisionName &bull; @ImportController.FormatBracketSlotLabel(cell.ResolvedSlot.Value)
									</span>
								}
								else
								{
									<span class="badge bg-danger">Unresolved — Choose Override</span>
								}
							</div>
							<div class="col-12 col-md-4">
								<label class="visually-hidden" for="overrideSelect_@i">Override mapping for cell @cell.CellReference</label>
								<select id="overrideSelect_@i"
										name="overrides[@i].Selection"
										class="form-select form-select-sm bracket-override-select">
									@foreach (var opt in Model.BracketOverrideOptions.Where(o => o.Group == null))
									{
										<option value="@opt.Value" selected="@(string.Equals(opt.Value, overrideInput.Selection, StringComparison.OrdinalIgnoreCase))">@opt.Text</option>
									}
									@foreach (var grp in Model.BracketOverrideOptions.Where(o => o.Group != null).GroupBy(o => o.Group!.Name))
									{
										<optgroup label="@grp.Key">
											@foreach (var opt in grp)
											{
												<option value="@opt.Value" selected="@(string.Equals(opt.Value, overrideInput.Selection, StringComparison.OrdinalIgnoreCase))">@opt.Text</option>
											}
										</optgroup>
									}
								</select>
							</div>
						</div>
					</div>
				}

				<div class="d-flex flex-wrap align-items-center gap-2 mt-2">
					<button type="submit" class="btn btn-outline-primary">
						<i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Re-validate Overrides
					</button>
					<span id="overrideDirtyNotice" class="small text-warning-emphasis fw-semibold d-none">
						<i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>Overrides changed — click Re-validate Overrides to refresh preview status.
					</span>
				</div>
			</form>
		</div>
	</div>
}

<div class="card mb-4">
	<div class="card-header">
		<h2 class="h6 mb-0 fw-bold">Divisions, Pools &amp; Schedules (@Model.Preview.Divisions.Count)</h2>
	</div>
	<div class="card-body p-0">
		<div class="accordion accordion-flush" id="divisionPreviewAccordion">
			@for (var d = 0; d < Model.Preview.Divisions.Count; d++)
			{
				var div = Model.Preview.Divisions[d];
				var headingId = $"divHeading_{d}";
				var collapseId = $"divCollapse_{d}";
				var totalTeams = div.Pools.Sum(p => p.Teams.Count);

				<div class="accordion-item">
					<h3 class="accordion-header" id="@headingId">
						<button class="accordion-button @(d == 0 ? "" : "collapsed")"
								type="button"
								data-bs-toggle="collapse"
								data-bs-target="#@collapseId"
								aria-expanded="@(d == 0 ? "true" : "false")"
								aria-controls="@collapseId">
							<span class="d-flex flex-wrap align-items-center gap-2 w-100 me-2">
								<strong>@div.DivisionName</strong>
								<span class="badge bg-primary-subtle text-primary-emphasis">@totalTeams Teams &bull; @div.Pools.Count @(div.Pools.Count == 1 ? "Pool" : "Pools")</span>
								<span class="badge bg-secondary-subtle text-secondary-emphasis">@div.PoolPlayGames.Count Pool Games</span>
								@if (div.ChampionshipGames.Count > 0)
								{
									<span class="badge bg-success-subtle text-success-emphasis">@div.ChampionshipGames.Count Bracket Games</span>
								}
								else
								{
									<span class="badge bg-light text-dark border">No Bracket (Pool Winner)</span>
								}
								<span class="badge bg-info-subtle text-info-emphasis">@div.ShootoutRoundCount PSO Rds (@div.ShootoutMatchupCount Matchups)</span>
							</span>
						</button>
					</h3>
					<div id="@collapseId"
						 class="accordion-collapse collapse @(d == 0 ? "show" : "")"
						 aria-labelledby="@headingId"
						 data-bs-parent="#divisionPreviewAccordion">
						<div class="accordion-body">
							<div class="row g-3 mb-3">
								@foreach (var pool in div.Pools)
								{
									<div class="col-12 col-md-6 col-xl-4">
										<div class="card h-100">
											<div class="card-header py-2 fw-bold">Pool @pool.PoolName (@pool.Teams.Count teams)</div>
											<ul class="list-group list-group-flush small">
												@foreach (var team in pool.Teams)
												{
													<li class="list-group-item d-flex justify-content-between align-items-center">
														<span>
															<span class="badge bg-dark me-1">@team.Code</span>
															<strong>@team.DisplayName</strong>
														</span>
														<span class="text-muted">R@(team.RegionNumber)</span>
													</li>
												}
											</ul>
										</div>
									</div>
								}
							</div>

							<h4 class="h6 fw-bold mb-2">Pool-Play Schedule (@div.PoolPlayGames.Count)</h4>
							<div class="table-responsive mb-3">
								<table class="table table-sm table-striped align-middle mb-0">
									<thead>
										<tr>
											<th>Rd</th>
											<th>Pool</th>
											<th>Date &amp; Time</th>
											<th>Field</th>
											<th>Matchup</th>
										</tr>
									</thead>
									<tbody>
										@foreach (var game in div.PoolPlayGames.OrderBy(g => g.Round).ThenBy(g => g.ScheduledDateTime).ThenBy(g => g.Location))
										{
											<tr>
												<td>@game.Round</td>
												<td>@game.PoolName</td>
												<td>@game.ScheduledDateTime.ToString("ddd M/d h:mm tt")</td>
												<td>@game.Location</td>
												<td><strong>@game.HomeTeamCode</strong> vs <strong>@game.AwayTeamCode</strong></td>
											</tr>
										}
									</tbody>
								</table>
							</div>

							@if (div.ChampionshipGames.Count > 0)
							{
								<h4 class="h6 fw-bold mb-2">Championship Bracket Slots (@div.ChampionshipGames.Count)</h4>
								<div class="table-responsive">
									<table class="table table-sm table-striped align-middle mb-0">
										<thead>
											<tr>
												<th>Slot</th>
												<th>Date &amp; Time</th>
												<th>Field</th>
												<th>Matchup Sources</th>
											</tr>
										</thead>
										<tbody>
											@foreach (var bg in div.ChampionshipGames.OrderBy(g => g.ScheduledDateTime ?? DateTime.MaxValue))
											{
												<tr>
													<td><span class="badge bg-success-subtle text-success-emphasis">@ImportController.FormatBracketSlotLabel(bg.Slot)</span></td>
													<td>@(bg.ScheduledDateTime?.ToString("ddd M/d h:mm tt") ?? "Unscheduled")</td>
													<td>@(string.IsNullOrWhiteSpace(bg.Location) ? "TBD" : bg.Location)</td>
													<td>@bg.HomeSourceDescription vs @bg.AwaySourceDescription</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							}
						</div>
					</div>
				</div>
			}
		</div>
	</div>
</div>

<form method="post" asp-action="Confirm" id="confirmImportForm">
	<input type="hidden" name="previewToken" value="@Model.PreviewToken" />
	<div id="confirmHiddenOverrides"></div>

	@if (Model.Preview.HasExistingScores)
	{
		<div class="alert alert-danger border-danger mb-3" role="alert">
			<div class="fw-bold mb-1">
				<i class="bi bi-exclamation-octagon-fill me-1" aria-hidden="true"></i>
				Existing Game or Shootout Scores Detected in @Model.TournamentName!
			</div>
			<p class="small mb-2">
				Re-importing this workbook will replace all divisions, schedules, and <strong>permanently erase recorded scores</strong> for @Model.TournamentName.
			</p>
			<div class="form-check">
				<input class="form-check-input"
					   type="checkbox"
					   id="allowOverwriteScores"
					   name="allowOverwriteScores"
					   value="true"
					   data-required="true"
					   checked="@Model.AllowOverwriteScores" />
				<label class="form-check-label fw-semibold" for="allowOverwriteScores">
					I understand and want to overwrite existing schedules and recorded scores for @Model.TournamentName.
				</label>
			</div>
		</div>
	}
	else if (Model.Preview.HasExistingData)
	{
		<div class="alert alert-warning mb-3" role="alert">
			<i class="bi bi-info-circle-fill me-1" aria-hidden="true"></i>
			<strong>Note:</strong> @Model.TournamentName already has imported schedule data (with no scores entered yet). Confirming will cleanly replace that schedule.
		</div>
	}

	<div class="d-flex flex-wrap gap-2">
		<button type="submit"
				class="btn btn-success btn-lg"
				id="confirmImportBtn"
				disabled="@(!Model.Preview.IsValid)">
			<span class="spinner-border spinner-border-sm d-none me-1" id="confirmBtnSpinner" role="status" aria-hidden="true"></span>
			<i class="bi bi-cloud-check-fill me-1" id="confirmBtnIcon" aria-hidden="true"></i>
			Confirm &amp; Import Schedule
		</button>
		<a asp-action="Upload" asp-route-yearId="@Model.TournamentYearId" class="btn btn-outline-secondary btn-lg">Cancel</a>
	</div>
</form>

@section Scripts {
	<script src="~/js/import-preview.js" asp-append-version="true"></script>
}
