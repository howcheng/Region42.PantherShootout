@model IReadOnlyList<Region42.PantherShootout.Web.Models.PsoMatchupItemViewModel>

<div class="card">
	<div class="card-header py-2">
		<h3 class="h6 mb-0 fw-bold">
			<i class="bi bi-list-check me-1" aria-hidden="true"></i>Shootout Round Matchups
		</h3>
	</div>
	<div class="card-body">
		@if (Model.Count == 0)
		{
			<p class="text-muted mb-0">No shootout rounds scheduled for this division.</p>
		}
		else
		{
			@foreach (var roundGroup in Model.GroupBy(m => m.Round).OrderBy(g => g.Key))
			{
				<div class="mb-3">
					<h4 class="text-muted text-uppercase small fw-bold mb-2">PSO Round @roundGroup.Key</h4>
					@if (roundGroup.Key == 4)
					{
						<div class="alert alert-secondary py-1 px-2 small mb-2">
							<i class="bi bi-info-circle me-1" aria-hidden="true"></i>
							Each team counts at most 3 shootout turns. Any team that already got 3 turns in Rounds 1&ndash;3 does not count its Round 4 score.
						</div>
					}

					@foreach (var item in roundGroup)
					{
						var homeHigher = item.HasScore && item.HomePkGoals > item.AwayPkGoals;
						var awayHigher = item.HasScore && item.AwayPkGoals > item.HomePkGoals;

						<div class="pso-matchup-card">
							<div class="d-flex justify-content-between align-items-center mb-1">
								<span class="badge bg-info-subtle text-info-emphasis">@item.SourceLabel</span>
								<small class="text-muted">
									@if (item.ScheduledDateTime.HasValue)
									{
										@item.ScheduledDateTime.Value.ToString("ddd, MMM d, h:mm tt")
										@if (!string.IsNullOrWhiteSpace(item.Location))
										{
											<span> &bull; @item.Location</span>
										}
									}
									else if (!string.IsNullOrWhiteSpace(item.Location))
									{
										<span>@item.Location</span>
									}
								</small>
							</div>

							<div class="row align-items-center g-1">
								<div class="col-5 text-end @(homeHigher ? "fw-bold text-success" : "") @(!item.IsSeeded ? "text-muted fst-italic" : "")">
									<span class="d-none d-sm-inline">@item.HomeFullDisplay</span>
									<span class="d-sm-none">@item.HomeShortDisplay</span>
								</div>
								<div class="col-2 text-center px-0">
									@if (item.HasScore)
									{
										<span class="badge bg-primary">
											<span class="@(item.HomePsoDoesNotCount ? "capped-round-score" : "")">@item.HomePkGoals</span>
											-
											<span class="@(item.AwayPsoDoesNotCount ? "capped-round-score" : "")">@item.AwayPkGoals</span>
										</span>
									}
									else
									{
										<span class="badge bg-secondary">PK</span>
									}
								</div>
								<div class="col-5 @(awayHigher ? "fw-bold text-success" : "") @(!item.IsSeeded ? "text-muted fst-italic" : "")">
									<span class="d-none d-sm-inline">@item.AwayFullDisplay</span>
									<span class="d-sm-none">@item.AwayShortDisplay</span>
								</div>
							</div>

							@if (!string.IsNullOrWhiteSpace(item.NonCountingPsoTeamCode))
							{
								<div class="small text-muted text-center mt-1 pt-1 border-top">
									<i class="bi bi-slash-circle me-1" aria-hidden="true"></i>@item.NonCountingPsoTeamCode score does not count (already had 3 turns)
								</div>
							}
						</div>
					}
				</div>
			}
		}
	</div>
</div>
