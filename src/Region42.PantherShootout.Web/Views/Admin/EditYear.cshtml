@model Region42.PantherShootout.Web.Models.EditTournamentYearViewModel
@{
	ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="row justify-content-center">
	<div class="col-12 col-md-8 col-lg-6">
		<div class="d-flex justify-content-between align-items-center mb-3">
			<h1 class="h3 mb-0">Edit Tournament Year (@Model.Year)</h1>
			<a asp-action="Years" class="btn btn-outline-secondary btn-sm">
				<i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back
			</a>
		</div>

		@if (!ViewData.ModelState.IsValid)
		{
			<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
		}

		<div class="card">
			<div class="card-body">
				<form method="post" asp-action="EditYear">
					<input type="hidden" asp-for="Id" />
					<input type="hidden" asp-for="Year" />

					<div class="mb-3">
						<label asp-for="Name" class="form-label fw-semibold">Display Name</label>
						<input asp-for="Name" class="form-control" required />
						<span asp-validation-for="Name" class="text-danger small"></span>
					</div>

					<div class="mb-3">
						<label asp-for="CustomMessage" class="form-label fw-semibold">Tournament Announcement Banner</label>
						<textarea asp-for="CustomMessage" class="form-control" rows="3" placeholder="Leave blank for no announcement banner"></textarea>
						<span asp-validation-for="CustomMessage" class="text-danger small"></span>
						<div class="form-text">Displayed at the top of the landing page and division views for @Model.Year.</div>
					</div>

					<div class="form-check mb-4">
						<input asp-for="IsActive" class="form-check-input" />
						<label asp-for="IsActive" class="form-check-label">Active tournament year</label>
					</div>

					<div class="d-flex gap-2">
						<button type="submit" class="btn btn-primary">
							<i class="bi bi-save me-1" aria-hidden="true"></i>Save Changes
						</button>
						<a asp-action="Years" class="btn btn-outline-secondary">Cancel</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
