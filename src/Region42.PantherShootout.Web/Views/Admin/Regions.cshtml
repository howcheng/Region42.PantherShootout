@model Region42.PantherShootout.Web.Models.AysoRegionsIndexViewModel
@{
	ViewData["Title"] = "AYSO Regions";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
	<div>
		<h1 class="h3 mb-1">AYSO Region Mappings</h1>
		<p class="text-muted small mb-0">
			Year-independent region number-to-city names (stored in <code>regions.json</code>) used across all tournament years.
		</p>
	</div>
	@if (!string.IsNullOrWhiteSpace(Model.ReturnToImport))
	{
		<a asp-controller="Import" asp-action="Upload" class="btn btn-primary btn-sm">
			<i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to Schedule Upload
		</a>
	}
</div>

@if (!ViewData.ModelState.IsValid)
{
	<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
}

<div class="row g-4">
	<div class="col-12 col-lg-4">
		<div class="card">
			<div class="card-header">
				<h2 class="h6 mb-0 fw-bold" id="regionFormTitle">
					@(Model.EditId.HasValue ? $"Edit AYSO Region {Model.RegionNumber}" : "Add or Update AYSO Region")
				</h2>
			</div>
			<div class="card-body">
				<form method="post" asp-action="SaveRegion">
					<input type="hidden" asp-for="EditId" id="EditId" />
					<input type="hidden" asp-for="ReturnToImport" />

					<div class="mb-3">
						<label asp-for="RegionNumber" class="form-label fw-semibold">Region Number</label>
						<input asp-for="RegionNumber"
							   id="RegionNumber"
							   class="form-control"
							   value="@(Model.RegionNumber > 0 ? Model.RegionNumber : "")"
							   min="1"
							   max="99999"
							   inputmode="numeric"
							   placeholder="e.g. 42"
							   required />
						<span asp-validation-for="RegionNumber" class="text-danger small"></span>
					</div>

					<div class="mb-3">
						<label asp-for="Name" class="form-label fw-semibold">City / Region Name</label>
						<input asp-for="Name"
							   id="Name"
							   class="form-control"
							   placeholder="e.g. Newbury Park"
							   required />
						<span asp-validation-for="Name" class="text-danger small"></span>
					</div>

					<div class="d-flex gap-2">
						<button type="submit" class="btn btn-primary flex-grow-1">
							<i class="bi bi-save me-1" aria-hidden="true"></i>
							<span id="regionSubmitBtnText">@(Model.EditId.HasValue ? "Update Region" : "Save Region")</span>
						</button>
						<button type="button"
								id="cancelRegionEditBtn"
								class="btn btn-outline-secondary @(Model.EditId.HasValue ? "" : "d-none")">
							Cancel
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<div class="col-12 col-lg-8">
		<div class="card">
			<div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
				<h2 class="h6 mb-0 fw-bold">Configured Regions (@Model.Regions.Count)</h2>
				<div class="col-12 col-sm-6">
					<label class="visually-hidden" for="regionSearchInput">Search regions</label>
					<input type="search"
						   id="regionSearchInput"
						   class="form-control form-control-sm"
						   placeholder="Filter by region # or city..." />
				</div>
			</div>
			<div class="card-body p-0">
				<div class="table-responsive">
					<table class="table table-striped table-hover align-middle mb-0">
						<thead>
							<tr>
								<th>Region #</th>
								<th>Name</th>
								<th class="text-center">Teams</th>
								<th class="text-end">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var region in Model.Regions)
							{
								<tr class="region-item-row" data-search="@($"{region.RegionNumber} {region.Name}")">
									<td><strong>@region.RegionNumber</strong></td>
									<td>@region.Name</td>
									<td class="text-center">
										@if (region.TeamUsageCount > 0)
										{
											<span class="badge bg-info-subtle text-info-emphasis">@region.TeamUsageCount</span>
										}
										else
										{
											<span class="text-muted small">0</span>
										}
									</td>
									<td class="text-end">
										<div class="d-inline-flex gap-1">
											<button type="button"
													class="btn btn-sm btn-outline-primary edit-region-btn"
													data-region-id="@region.Id"
													data-region-number="@region.RegionNumber"
													data-region-name="@region.Name"
													title="Edit Region @region.RegionNumber">
												<i class="bi bi-pencil" aria-hidden="true"></i>
												<span class="visually-hidden">Edit</span>
											</button>
											@if (region.TeamUsageCount == 0)
											{
												<form method="post"
													  asp-action="DeleteRegion"
													  class="d-inline delete-region-form"
													  data-region-label="Region @region.RegionNumber (@region.Name)">
													<input type="hidden" name="id" value="@region.Id" />
													<input type="hidden" name="returnToImport" value="@Model.ReturnToImport" />
													<button type="submit"
															class="btn btn-sm btn-outline-danger"
															title="Delete Region @region.RegionNumber">
														<i class="bi bi-trash" aria-hidden="true"></i>
														<span class="visually-hidden">Delete</span>
													</button>
												</form>
											}
											else
											{
												<button type="button"
														class="btn btn-sm btn-outline-secondary"
														disabled
														title="Cannot delete while referenced by @region.TeamUsageCount team(s)">
													<i class="bi bi-trash" aria-hidden="true"></i>
													<span class="visually-hidden">In use</span>
												</button>
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				<div id="regionSearchEmpty" class="p-3 text-center text-muted small d-none">
					No regions match your search filter.
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script src="~/js/admin-regions.js" asp-append-version="true"></script>
}
