@model Region42.PantherShootout.Web.Models.ChampionshipBracketSectionViewModel
@using Region42.PantherShootout.Domain.Enums
@{
	var sf1 = Model.Matches.FirstOrDefault(m => m.Slot == BracketSlot.Semifinal1);
	var sf2 = Model.Matches.FirstOrDefault(m => m.Slot == BracketSlot.Semifinal2);
	var finalMatch = Model.Matches.FirstOrDefault(m => m.Slot == BracketSlot.Championship);
	var thirdPlace = Model.Matches.FirstOrDefault(m => m.Slot == BracketSlot.ThirdPlace);
	var consolation = Model.Matches.FirstOrDefault(m => m.Slot == BracketSlot.Consolation);
}

<div class="card">
	<div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
		<h3 class="h6 mb-0 fw-bold">
			<i class="bi bi-diagram-3-fill text-primary me-1" aria-hidden="true"></i>Championship Bracket (6-Team Semifinals &amp; Finals)
		</h3>
		@if (!Model.PoolPlayFinal)
		{
			<span class="badge bg-secondary-subtle text-secondary-emphasis">Seeds Pending Pool Play</span>
		}
	</div>
	<div class="card-body">
		@if (!string.IsNullOrWhiteSpace(Model.ChampionTeamDisplay))
		{
			<div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2" role="alert">
				<i class="bi bi-trophy-fill fs-4 text-warning" aria-hidden="true"></i>
				<div>
					<strong>Division Champion:</strong> @Model.ChampionTeamDisplay
				</div>
			</div>
		}

		<div class="semifinal-tree-grid mb-2">
			<div>
				<h4 class="text-muted text-uppercase small fw-bold mb-2">Semifinals</h4>
				@if (sf1 is not null)
				{
					<partial name="_BracketMatchCard" model="sf1" />
				}
				@if (sf2 is not null)
				{
					<partial name="_BracketMatchCard" model="sf2" />
				}
			</div>

			<div class="d-none d-md-flex flex-column align-items-center text-muted">
				<i class="bi bi-arrow-right-circle fs-4" aria-hidden="true"></i>
			</div>

			<div>
				<h4 class="text-muted text-uppercase small fw-bold mb-2">Championship &amp; 3rd Place</h4>
				@if (finalMatch is not null)
				{
					<partial name="_BracketMatchCard" model="finalMatch" />
				}
				@if (thirdPlace is not null)
				{
					<partial name="_BracketMatchCard" model="thirdPlace" />
				}
			</div>
		</div>

		@if (consolation is not null)
		{
			<h4 class="text-muted text-uppercase small fw-bold mt-3 mb-2">Consolation Match (3rd Pool Seeds)</h4>
			<div class="row">
				<div class="col-12 col-md-6">
					<partial name="_BracketMatchCard" model="consolation" />
				</div>
			</div>
		}
	</div>
</div>
