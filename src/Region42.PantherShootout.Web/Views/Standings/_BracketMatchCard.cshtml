@model Region42.PantherShootout.Web.Models.BracketMatchCardViewModel
@using Region42.PantherShootout.Domain.Enums
@{
	var slotClass = Model.Slot == BracketSlot.Championship
		? "championship-slot"
		: (Model.Slot is BracketSlot.Consolation or BracketSlot.ThirdPlace ? "consolation-slot" : "");
	var homeIsWinner = Model.WinnerTeamId.HasValue && Model.HomeTeamId.HasValue && Model.WinnerTeamId == Model.HomeTeamId;
	var awayIsWinner = Model.WinnerTeamId.HasValue && Model.AwayTeamId.HasValue && Model.WinnerTeamId == Model.AwayTeamId;
}

<div class="bracket-match-card @slotClass">
	<div class="d-flex justify-content-between align-items-center gap-2 mb-2">
		<span class="badge @(Model.Slot == BracketSlot.Championship ? "bg-warning text-dark" : "bg-success-subtle text-success-emphasis")">
			@if (Model.Slot == BracketSlot.Championship)
			{
				<i class="bi bi-trophy-fill me-1" aria-hidden="true"></i>
			}
			@Model.SlotLabel
		</span>
		<small class="text-muted text-end">
			@if (Model.ScheduledDateTime.HasValue)
			{
				@Model.ScheduledDateTime.Value.ToString("ddd, MMM d, h:mm tt")
				@if (!string.IsNullOrWhiteSpace(Model.Location))
				{
					<span> &bull; @Model.Location</span>
				}
			}
			else if (!string.IsNullOrWhiteSpace(Model.Location))
			{
				<span>@Model.Location</span>
			}
			else
			{
				<span class="fst-italic">Time TBD</span>
			}
		</small>
	</div>

	<div class="bracket-team-line @(homeIsWinner ? "winner" : "")">
		<span class="@(Model.IsHomeSeeded ? "" : "text-muted fst-italic")">
			<span class="d-none d-sm-inline">@Model.HomeFullDisplay</span>
			<span class="d-sm-none">@Model.HomeShortDisplay</span>
		</span>
		@if (Model.HasScore)
		{
			<span class="badge @(homeIsWinner ? "bg-success" : "bg-secondary")">@Model.HomeGoals</span>
		}
	</div>

	<div class="bracket-team-line @(awayIsWinner ? "winner" : "")">
		<span class="@(Model.IsAwaySeeded ? "" : "text-muted fst-italic")">
			<span class="d-none d-sm-inline">@Model.AwayFullDisplay</span>
			<span class="d-sm-none">@Model.AwayShortDisplay</span>
		</span>
		@if (Model.HasScore)
		{
			<span class="badge @(awayIsWinner ? "bg-success" : "bg-secondary")">@Model.AwayGoals</span>
		}
	</div>

	@if (Model.IsForfeit || Model.HasRound4PsoScore)
	{
		<div class="d-flex justify-content-between align-items-center small mt-1 pt-1 border-top">
			@if (Model.IsForfeit)
			{
				<span class="badge bg-warning-subtle text-warning-emphasis">Forfeit</span>
			}
			else
			{
				<span></span>
			}
			@if (Model.HasRound4PsoScore)
			{
				<span class="badge bg-info-subtle text-info-emphasis">PSO R4 PK: @Model.HomePkGoals - @Model.AwayPkGoals</span>
			}
		</div>
	}
</div>
